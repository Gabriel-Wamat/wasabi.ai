// Wasabi — schema local-first (SQLite + sqlite-vec)
//
// SQLite differences vs PostgreSQL:
//   - String[] não existe → uso Json (Prisma serializa/desserializa).
//   - @db.Uuid não existe → strings comuns (uuidv7 gera no app layer).
//   - @db.Text não existe (TEXT é unbounded por padrão).
//   - Embeddings vetoriais ficam em tabela virtual sqlite-vec
//     gerenciada por conexão paralela (better-sqlite3); não aparecem aqui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id
  name               String
  email              String    @unique
  passwordHash       String
  avatar             String?
  timezone           String    @default("America/Sao_Paulo")
  plan               String    @default("FREE")
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  documents         Document[]
  projects          Project[]
  transactions      Transaction[]
  goals             FinancialGoal[]
  categories        FinancialCategory[]
  sessions          Session[]
  chatConversations ChatConversation[]
  dataEmbeddings    DataEmbedding[]
  llmSettings       UserLlmSettings?

  @@index([email])
}

model UserLlmSettings {
  id              String   @id
  userId          String   @unique
  provider        String   @default("anthropic")
  model           String   @default("claude-haiku-4-5")
  apiKeyEncrypted String?
  baseUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Document {
  id         String    @id
  userId     String
  type       String
  category   String
  title      String
  number     String?
  issuerName String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  fileUrl    String?
  tags       String    @default("[]")
  metadata   String    @default("{}")
  company    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Project {
  id          String    @id
  userId      String
  title       String
  description String?
  status      String    @default("ACTIVE")
  priority    String    @default("MEDIUM")
  progress    Int       @default(0)
  tags        String    @default("[]")
  links       String    @default("[]")
  color       String    @default("#11C76F")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model FinancialCategory {
  id        String  @id
  userId    String?
  name      String
  type      String
  color     String  @default("#888888")
  icon      String  @default("💰")
  isDefault Boolean @default(false)
  ipcaGroup String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, type])
}

model Transaction {
  id            String   @id
  userId        String
  type          String
  amount        Int
  categoryId    String
  description   String
  date          DateTime
  paymentMethod String   @default("PIX")
  isRecurring   Boolean  @default(false)
  tags          String   @default("[]")
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinancialCategory @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, categoryId])
}

model FinancialGoal {
  id            String   @id
  userId        String
  title         String
  targetAmount  Int
  currentAmount Int      @default(0)
  deadline      DateTime
  icon          String   @default("🎯")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatConversation {
  id         String    @id
  userId     String
  title      String    @default("Nova conversa")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String   @id
  conversationId String
  role           String
  content        String
  tokensUsed     Int?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// DataEmbedding metadata stays in Prisma; the actual vector is stored in
// the sqlite-vec virtual table `vec_embeddings` (separate connection).
model DataEmbedding {
  id         String   @id
  userId     String
  sourceType String
  sourceId   String
  content    String
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, sourceType])
}
