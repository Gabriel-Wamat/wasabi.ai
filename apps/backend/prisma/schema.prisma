generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

enum DocumentType {
  PERSONAL
  WORK
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  OTHER
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id                 String    @id @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String
  avatar             String?
  timezone           String    @default("America/Sao_Paulo")
  plan               Plan      @default(FREE)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  documents         Document[]
  projects          Project[]
  transactions      Transaction[]
  goals             FinancialGoal[]
  categories        FinancialCategory[]
  sessions          Session[]
  chatConversations ChatConversation[]
  dataEmbeddings     DataEmbedding[]
  llmSettings        UserLlmSettings?

  @@index([email])
}

model UserLlmSettings {
  id              String   @id @db.Uuid
  userId          String   @unique @db.Uuid
  provider        String   @default("openai")
  model           String   @default("gpt-5-mini")
  apiKeyEncrypted String?  @db.Text
  baseUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Document {
  id         String       @id @db.Uuid
  userId     String       @db.Uuid
  type       DocumentType
  category   String
  title      String
  number     String?
  issuerName String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  fileUrl    String?
  tags       String[]     @default([])
  metadata   Json         @default("{}")
  company    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Project {
  id          String        @id @db.Uuid
  userId      String        @db.Uuid
  title       String
  description String?
  status      ProjectStatus @default(ACTIVE)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0)
  tags        String[]      @default([])
  links       Json          @default("[]")
  color       String        @default("#11C76F")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model FinancialCategory {
  id        String          @id @db.Uuid
  userId    String?         @db.Uuid
  name      String
  type      TransactionType
  color     String          @default("#888888")
  icon      String          @default("💰")
  isDefault Boolean         @default(false)
  ipcaGroup String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, type])
}

model Transaction {
  id            String          @id @db.Uuid
  userId        String          @db.Uuid
  type          TransactionType
  amount        Int
  categoryId    String          @db.Uuid
  description   String
  date          DateTime
  paymentMethod PaymentMethod   @default(PIX)
  isRecurring   Boolean         @default(false)
  tags          String[]        @default([])
  attachmentUrl String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinancialCategory @relation(fields: [categoryId], references: [id])

  @@index([userId, date(sort: Desc)])
  @@index([userId, categoryId])
}

model FinancialGoal {
  id            String   @id @db.Uuid
  userId        String   @db.Uuid
  title         String
  targetAmount  Int
  currentAmount Int      @default(0)
  deadline      DateTime
  icon          String   @default("🎯")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatConversation {
  id         String        @id @db.Uuid
  userId     String        @db.Uuid
  title      String        @default("Nova conversa")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id             String   @id @db.Uuid
  conversationId String   @db.Uuid
  role           ChatRole
  content        String   @db.Text
  tokensUsed     Int?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model DataEmbedding {
  id         String   @id @db.Uuid
  userId     String   @db.Uuid
  sourceType String
  sourceId   String
  content    String   @db.Text
  metadata   Json     @default("{}")
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, sourceType])
}
