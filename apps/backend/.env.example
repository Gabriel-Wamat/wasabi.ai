# Backend environment example for Wamat Personal
# Copy to `.env` and adjust according to your setup.

# Runtime
NODE_ENV=development
PORT=3001

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3003

# Database (Prisma)
# For SQLite (default derived from app data dir), leave empty.
# For Postgres: postgresql://user:pass@host:5432/dbname
#DATABASE_URL=

# JWT secret (optional). If empty, a strong local secret is generated and
# stored encrypted in the application config file on first run.
#JWT_SECRET=

# Local LLM (Ollama)
#OLLAMA_BASE_URL=http://localhost:11434

# Daily Slack digest (posts every day at 09:30 in the configured timezone)
#SLACK_DIGEST_WEBHOOK_URL=https://hooks.slack.com/services/...
#SLACK_DIGEST_ENABLED=true
SLACK_DIGEST_TIMEZONE=America/Sao_Paulo
