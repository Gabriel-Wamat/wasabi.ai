{
  "name": "@personal-hub/backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "prebuild": "pnpm run generate",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:sidecar": "bun build src/server.ts --compile --minify --target bun --outfile dist/wasabi-backend",
    "start": "node dist/server.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma": "prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.1043.0",
    "@aws-sdk/s3-request-presigner": "^3.1043.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.14.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "pino-pretty": "^11.2.0",
    "sqlite-vec": "^0.1.6",
    "uuidv7": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "prisma": "^5.14.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
