{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Hub",
  "version": "1.0.0",
  "identifier": "dev.personalhub.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal Hub",
        "width": 1100,
        "height": 680,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "closable": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Personal Hub"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Personal Hub",
    "category": "Productivity"
  },
  "plugins": {
    "autostart": {
      "mobile": false,
      "desktop": true
    }
  }
}
