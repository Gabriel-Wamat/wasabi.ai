{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wasabi",
  "version": "1.0.0",
  "identifier": "app.wasabi.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../web && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wasabi",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "closable": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https: data:; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' tauri: https: http://localhost:* ws://localhost:*; font-src 'self' data:"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Wasabi"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Wasabi",
    "category": "Productivity",
    "shortDescription": "Plataforma de gestão pessoal — documentos, finanças, projetos e metas em um só lugar.",
    "longDescription": "Wasabi é uma plataforma desktop de gestão pessoal. Centraliza documentos pessoais e de trabalho, controle financeiro com categorias e metas, projetos com prioridades e progresso, integração com Google Calendar e um assistente conversacional sobre seus próprios dados.",
    "copyright": "© 2025 Wasabi",
    "homepage": "https://github.com/wasabiapp/wasabi",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR", "English"],
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": null,
        "windowSize": { "width": 540, "height": 380 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
