{
  "name": "personal-hub",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @personal-hub/backend --filter @personal-hub/web dev",
    "dev:desktop": "pnpm --filter @personal-hub/desktop dev",
    "dev:desktop:backend": "PORT=8080 CORS_ORIGIN=http://localhost:3000,http://localhost:3003,http://tauri.localhost,tauri://localhost pnpm --filter @personal-hub/backend dev",
    "dev:desktop:all": "pnpm --parallel dev:desktop:backend dev:desktop",
    "build": "pnpm --filter @personal-hub/backend build && pnpm --filter @personal-hub/web build",
    "build:desktop": "pnpm --filter @personal-hub/web build && pnpm --filter @personal-hub/desktop build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend web",
    "docker:reset": "docker compose down -v",
    "db:seed:demo": "SEED_DEMO_DATA=true pnpm --filter @personal-hub/backend seed",
    "docker:seed:demo": "docker compose exec -e SEED_DEMO_DATA=true backend pnpm --filter @personal-hub/backend prisma db seed",
    "lint": "pnpm typecheck",
    "guard:daily": "bash scripts/guard/daily-guard.sh",
    "typecheck": "pnpm --filter @personal-hub/backend typecheck && pnpm --filter @personal-hub/web typecheck",
    "test": "pnpm --filter @personal-hub/backend test"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "protobufjs": "7.5.6"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
