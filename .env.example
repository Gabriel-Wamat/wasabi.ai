# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://ph_user:ph_pass@localhost:5433/personalhub
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Desktop/local-only handshake (security: keep disabled in prod)
ENABLE_LOCAL_HANDSHAKE=false

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth-callback.html

# Daily Slack digest (posts every day at 09:30 in the configured timezone)
SLACK_DIGEST_WEBHOOK_URL=
SLACK_DIGEST_ENABLED=false
SLACK_DIGEST_TIMEZONE=America/Sao_Paulo

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=personalhub-dev
S3_ACCESS_KEY=minio_user
S3_SECRET_KEY=minio_pass
S3_REGION=us-east-1

# LLM provider for Ask Wasabi
# Options: anthropic, openai, ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
LLM_MAX_OUTPUT_TOKENS=1024
LLM_SETTINGS_SECRET=change-me-32-chars-for-llm-settings
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Vector search for Ask Wasabi
# Requires PostgreSQL with pgvector enabled. Docker uses pgvector/pgvector:pg16.
EMBEDDINGS_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_EXP001_ONBOARDING_ENABLED=false
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Docker Compose exposes the web app on http://localhost:3003
# and overrides service URLs internally.
